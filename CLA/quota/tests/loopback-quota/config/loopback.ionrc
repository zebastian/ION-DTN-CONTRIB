# ionrc for the quota CLA loopback test.  The ionconfig is written by
# dotest, so that ION's working directory - where quotaclo keeps its
# state file - is this test directory.
1 1 config/loopback_runtime.ionconfig
s
a contact +1 +3600 1 1 1000000000
a range +1 +3600 1 1 1
m production 1000000000
m consumption 1000000000
