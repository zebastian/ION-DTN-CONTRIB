#!/usr/bin/env bash
#
# Loopback test for the zcl compressing tunnel CLA.
#
# Node 1 sends to itself through zcl: zclo compresses the bundles into
# carriers addressed to ipn:1.7, the carriers are routed back into the
# zcl duct like everything else, zclo hands them to a UDP duct that is
# in no plan (-T), and zcli decompresses them and hands the bundles
# back to ION.  Checks delivery, that an expedited bundle skips the 2 s
# window, that compression happened and every carrier was handed off,
# that carriers take the lifetime of the bundles inside, that losing
# carriers costs only the chunks they belong to, and that a target duct
# in a plan is refused.
#
# Needs the zcl daemons (installed, or built in this tree), ION 4.1.4
# or later, and ION's udpcli/udpclo and bp test tools.
#
# The loss phase drops a share of the carrier datagrams with
# misc/linkimpair, checks that zcli gives up only the chunks hit, and
# that the stream carries on afterwards.  It runs only if it can get the
# privilege it needs, and is skipped otherwise:
#
#   * iptables, to queue the UDP port: as root, or through "sudo -n".
#   * CAP_NET_ADMIN for linkimpair, to bind the queue:
#         sudo setcap cap_net_admin+ep .../misc/linkimpair/linkimpair
#
# ION and the zcl daemons stay unprivileged.  The rule carries
# --queue-bypass, so a linkimpair that dies takes the loss away rather
# than the link, and it is removed on every exit path.
#
# Tunables (env overridable):
#   ZCL_UDP_PORT     UDP port of the carriers         (default 4758)
#   ZCL_LOSS_PCT     carriers dropped, percent        (default 25)
#   ZCL_NFQUEUE      NFQUEUE number                   (default 23)
#   LINKIMPAIR       path to the linkimpair binary
#

UDP_PORT="${ZCL_UDP_PORT:-4758}"
UDP_PORT2=$((UDP_PORT + 1))
LOSS_PCT="${ZCL_LOSS_PCT:-25}"
NFQUEUE_NUM="${ZCL_NFQUEUE:-23}"
LINKIMPAIR="${LINKIMPAIR:-$(cd ../../../../misc/linkimpair 2>/dev/null \
	&& pwd)/linkimpair}"
IPTABLES="${IPTABLES:-$(command -v iptables || echo /usr/sbin/iptables)}"
CONFIGDIR="./config"

# Prefer the daemons built in this tree.
BUILT=$(cd ../.. 2>/dev/null && pwd)
if [ -x "$BUILT/zclo" ] && [ -x "$BUILT/zcli" ]; then
	PATH="$BUILT:$PATH"
	export PATH
fi

if [ "$(id -u)" -eq 0 ]; then
	SUDO=""
else
	SUDO="sudo -n"
fi

echo "########################################"
echo
pwd | sed "s/\/.*\///" | xargs echo "NAME: "
echo
echo "PURPOSE: Testing the zcl CLA (zstd tunnel over UDP) in loopback."
echo
echo "########################################"

FAIL=0
fail() { echo "FAILURE: $1"; FAIL=1; }

# Polls for a condition instead of sleeping a fixed span.  $1 is the
# cap in seconds, the rest the command to try.
await()
{
	local cap="$1"
	local i

	shift
	for i in $(seq 1 $((cap * 10))); do
		"$@" && return 0
		sleep 0.1
	done

	return 1
}

received_file() { [ -f testfile1 ] && cmp -s sendfile testfile1; }
now_ms() { echo $(( $(date +%s%N) / 1000000 )); }

# Sends sendfile from ipn:1.1 to ipn:1.2 with class of service $1 and
# sets ELAPSED to the ms until it arrived (empty if it didn't).
timed_file()
{
	local t0

	rm -f testfile*
	bprecvfile ipn:1.2 & RP=$!
	sleep 1
	t0=$(now_ms)
	bpsendfile ipn:1.1 ipn:1.2 sendfile "$1"
	if await 10 received_file; then
		ELAPSED=$(( $(now_ms) - t0 ))
	else
		ELAPSED=
	fi
	kill $RP 2>/dev/null; wait $RP 2>/dev/null
}
logged() { grep -q "$1" ion.log 2>/dev/null; }

# Asks zcli for its counters (SIGUSR1) and sets STATS to the new line.
zcli_stats()
{
	local before

	before=$(grep -c "zcli stats" ion.log 2>/dev/null)
	pkill -USR1 -x zcli
	await 5 sh -c "[ \$(grep -c 'zcli stats' ion.log) -gt $before ]"
	STATS=$(grep "zcli stats" ion.log | tail -1)
}

# Reads one counter out of STATS: carriers, bad, stale, dropped,
# bundles, done, lost or corrupt.
stat()
{
	case "$1" in
	carriers) echo "$STATS" | sed -n 's/.*stats: \([0-9]*\) carriers.*/\1/p' ;;
	bundles) echo "$STATS" | sed -n 's/.*; \([0-9]*\) bundles,.*/\1/p' ;;
	done) echo "$STATS" | sed -n 's/.*chunks \([0-9]*\) done.*/\1/p' ;;
	*) echo "$STATS" | sed -n "s/.*[( ]\([0-9]*\) $1[,);].*/\1/p" ;;
	esac
}

IMPAIR_PID=""
RULE_ON=0

impair_off()
{
	if [ "$RULE_ON" -eq 1 ]; then
		while $SUDO "$IPTABLES" -D OUTPUT -o lo -p udp \
			--dport "$UDP_PORT" -j NFQUEUE \
			--queue-num "$NFQUEUE_NUM" --queue-bypass \
			2>/dev/null; do :; done
		RULE_ON=0
	fi

	if [ -n "$IMPAIR_PID" ]; then
		kill "$IMPAIR_PID" 2>/dev/null
		wait "$IMPAIR_PID" 2>/dev/null
		IMPAIR_PID=""
	fi
}

trap impair_off EXIT
trap 'impair_off; ./cleanup; exit 1' INT TERM

for t in zcli zclo udpcli udpclo bpsendfile bprecvfile bpdriver bpcounter; do
	if ! command -v "$t" >/dev/null 2>&1; then
		echo "SKIP: '$t' not found."
		exit 2
	fi
done

echo "Killing old ION..."
killm >/dev/null 2>&1
./cleanup 2>/dev/null
sleep 1

for f in bprc ipnrc; do
	sed -e "s|UDPPORT|${UDP_PORT}|g" "${CONFIGDIR}/loopback.$f" \
		> "${CONFIGDIR}/loopback_runtime.$f"
done

echo "Starting ION..."
ionadmin "${CONFIGDIR}/loopback.ionrc"
sleep 1
bpadmin "${CONFIGDIR}/loopback_runtime.bprc"

if ! await 10 logged "zcli is running" || ! await 10 logged "zclo is running"
then
	echo "ERROR: zcl daemons did not start."
	tail -30 ion.log 2>/dev/null
	./cleanup
	exit 1
fi

# --- Phase 1: one bundle --------------------------------------------------
echo "Phase 1: a file through the tunnel..."
head -c 3000 /dev/urandom | base64 > sendfile
timed_file 0.1
if [ -n "$ELAPSED" ]; then
	echo "  PASS: file delivered in $ELAPSED ms (window 2000 ms)."
	STD_MS=$ELAPSED
else
	fail "file not delivered through zcl."
	STD_MS=0
fi

# --- Phase 2: expedited skips the window ---------------------------------------
echo "Phase 2: the same file, expedited..."
timed_file 0.2
if [ -n "$ELAPSED" ] && [ "$ELAPSED" -lt 1000 ] && [ "$STD_MS" -ge 1500 ]
then
	echo "  PASS: expedited in $ELAPSED ms, standard took $STD_MS ms."
else
	fail "expedited not flushed at once (expedited '$ELAPSED' ms," \
		"standard $STD_MS ms)."
fi

# --- Phase 3: a burst, batched into few carriers ----------------------------
echo "Phase 3: 200 bundles with a 30 s lifetime..."
bpcounter ipn:1.2 200 > counter.out 2>&1 & CP=$!
sleep 1
bpdriver 200 ipn:1.1 ipn:1.2 -1000 t30 >/dev/null 2>&1
await 20 grep -q "bundles received: 200" counter.out
kill -9 $CP 2>/dev/null; wait $CP 2>/dev/null
if grep -q "bundles received: 200" counter.out; then
	echo "  PASS: 200 bundles received."
else
	fail "did not receive 200 bundles ($(grep -o 'received: [0-9]*' \
		counter.out | tail -1))."
fi

zcli_stats
echo "  $STATS"
CARRIERS=$(stat carriers)
BUNDLES=$(stat bundles)
if [ -n "$CARRIERS" ] && [ -n "$BUNDLES" ] && [ "$BUNDLES" -ge 203 ] \
	&& [ "$CARRIERS" -lt "$BUNDLES" ]; then
	echo "  PASS: $BUNDLES bundles arrived in $CARRIERS carriers over UDP."
else
	fail "carriers did not batch bundles (stats: $STATS)."
fi

if echo "$STATS" | grep -q "0 bad, 0 stale, 0 dropped" \
	&& echo "$STATS" | grep -q "0 lost, 0 corrupt"; then
	echo "  PASS: no carrier lost or refused."
else
	fail "receiver saw losses: $STATS"
fi

# --- Phase 4: carrier loss ------------------------------------------------
echo "Phase 4: ${LOSS_PCT}% of the carrier datagrams dropped..."
if [ ! -x "$LINKIMPAIR" ]; then
	echo "  SKIP: linkimpair not built at '$LINKIMPAIR' (set LINKIMPAIR)."
elif ! $SUDO "$IPTABLES" -I OUTPUT -o lo -p udp --dport "$UDP_PORT" \
	-j NFQUEUE --queue-num "$NFQUEUE_NUM" --queue-bypass 2>/dev/null; then
	echo "  SKIP: can't install the iptables rule; allow '$IPTABLES' via sudo."
else
	RULE_ON=1
	"$LINKIMPAIR" -q "$NFQUEUE_NUM" -l "$LOSS_PCT" -s 7 -v \
		> impair.log 2>&1 & IMPAIR_PID=$!
	sleep 1
	if ! kill -0 "$IMPAIR_PID" 2>/dev/null; then
		IMPAIR_PID=""
		impair_off
		echo "  SKIP: linkimpair can't bind the queue (CAP_NET_ADMIN?):"
		sed 's/^/    /' impair.log
	else
		zcli_stats
		B0=$(stat bundles); D0=$(stat done); L0=$(stat lost)

		# 1200 bundles in carriers of about 16 bundles and chunks of
		# about 65: dozens of carriers, many chunks.  bpcounter takes
		# them off ipn:1.2, so they don't queue there for the
		# recovery check below.
		bpcounter ipn:1.2 1201 > counter.out 2>&1 & CP=$!
		sleep 1
		bpdriver 1200 ipn:1.1 ipn:1.2 -1000 >/dev/null 2>&1

		# Let zcli give up the gaps: reorder timeout 2 s, ticks of 1 s.
		sleep 5
		kill -9 $CP 2>/dev/null; wait $CP 2>/dev/null
		impair_off
		IMPAIRED=$(grep -h 'dropped' impair.log | tail -1)
		DROPPED=$(echo "$IMPAIRED" | sed -n 's/.*dropped \([0-9]*\).*/\1/p')
		echo "  $IMPAIRED"

		# The stream must carry on once the link is clean again.  The
		# file's carrier also follows any carrier dropped last, so
		# every drop has opened a gap by the time it is in.
		rm -f testfile*
		bprecvfile ipn:1.2 & RP=$!
		sleep 1
		bpsendfile ipn:1.1 ipn:1.2 sendfile
		if await 10 received_file; then
			echo "  PASS: stream recovered after the losses."
		else
			fail "nothing delivered after the losses."
		fi

		zcli_stats
		echo "  $STATS"
		GOT=$(( $(stat bundles) - B0 - 1 ))
		DONE=$(( $(stat done) - D0 ))
		LOST=$(( $(stat lost) - L0 ))
		if [ "${DROPPED:-0}" -eq 0 ]; then
			fail "linkimpair dropped nothing; the phase proves nothing."
		elif [ "$LOST" -ge 1 ] && [ "$GOT" -gt 0 ] \
			&& [ "$GOT" -lt 1201 ]; then
			echo "  PASS: $DROPPED carriers dropped: $LOST chunk(s)" \
				"given up, $DONE completed, $GOT of 1201 bundles" \
				"delivered."
		else
			fail "loss not handled as expected (lost $LOST," \
				"done $DONE, delivered $GOT of 1201)."
		fi

		if [ "$(stat bad)" = 0 ] && [ "$(stat corrupt)" = 0 ]; then
			echo "  PASS: no carrier refused, no chunk corrupt."
		else
			fail "loss led to refused carriers or corrupt chunks."
		fi
		kill $RP 2>/dev/null; wait $RP 2>/dev/null
	fi
fi

# --- Phase 5: a target in a plan is refused ----------------------------------
echo "Phase 5: -T duct in a plan..."
bpadmin <<EOF >/dev/null 2>&1
a outduct udp 127.0.0.1:$UDP_PORT2 udpclo
a outduct zcl ipn:9.7 'zclo -T udp/127.0.0.1:$UDP_PORT2'
EOF
echo "a plan 9 udp/127.0.0.1:$UDP_PORT2" | ipnadmin >/dev/null 2>&1
echo "s outduct zcl ipn:9.7" | bpadmin >/dev/null 2>&1
if await 10 logged "duct is attached to a plan"; then
	echo "  PASS: zclo refused a target in a plan."
else
	fail "zclo started on a target in a plan."
fi

# --- Shutdown: zclo reports compression on exit -----------------------------
echo "Stopping ION..."
bpadmin . >/dev/null 2>&1
await 10 logged "zclo stats"
CLO=$(grep "zclo stats" ion.log | tail -1)
echo "  $CLO"
IN=$(echo "$CLO" | sed -n 's/.*bundles, \([0-9]*\) bytes in.*/\1/p')
OUT=$(echo "$CLO" | sed -n 's/.*carriers, \([0-9]*\) bytes out.*/\1/p')
if [ -n "$IN" ] && [ -n "$OUT" ] && [ "$OUT" -lt "$IN" ]; then
	echo "  PASS: $IN bytes of bundles sent as $OUT bytes of carriers."
else
	fail "no compression reported ($CLO)."
fi

# The last carrier is cut at shutdown, after zclo stopped taking
# bundles from its duct: it waits there for the next zclo.
SENT=$(echo "$CLO" | sed -n 's/.*; \([0-9]*\) carriers, .*/\1/p')
HANDED=$(echo "$CLO" | sed -n 's/.* \([0-9]*\) carriers handed off.*/\1/p')
if [ -n "$HANDED" ] && [ -n "$SENT" ] && [ "$HANDED" -ge 1 ] \
	&& [ "$HANDED" -ge $((SENT - 1)) ]; then
	echo "  PASS: $HANDED of $SENT carriers handed off to UDP."
else
	fail "carriers not handed off ($CLO)."
fi

# Chunks end early only where priority or lifetime changes between
# phases, never at every carrier of a steady stream.
SPLIT=$(echo "$CLO" | sed -n 's/.* \([0-9]*\) chunks split.*/\1/p')
if [ -n "$SPLIT" ] && [ "$SPLIT" -le 6 ]; then
	echo "  PASS: $SPLIT chunk(s) split, of $SENT carriers."
else
	fail "$SPLIT chunks split."
fi

# The 30 s bundles' carriers live 30 s plus the chunk's headroom (-C,
# 5 s) at most; nothing lives beyond -L, 86400 s.
LOW=$(echo "$CLO" | sed -n 's/.*carrier lifetime \([0-9]*\) to.*/\1/p')
HIGH=$(echo "$CLO" | sed -n 's/.*carrier lifetime [0-9]* to \([0-9]*\) s.*/\1/p')
if [ -n "$LOW" ] && [ "$LOW" -ge 1 ] && [ "$LOW" -le 35 ] \
	&& [ "$HIGH" -gt 35 ] && [ "$HIGH" -le 86400 ]; then
	echo "  PASS: carrier lifetimes $LOW to $HIGH s follow the bundles."
else
	fail "carrier lifetimes $LOW to $HIGH s."
fi

if [ $FAIL -ne 0 ]; then
	echo "ion.log tail:"
	tail -30 ion.log
fi

./cleanup
exit $FAIL
