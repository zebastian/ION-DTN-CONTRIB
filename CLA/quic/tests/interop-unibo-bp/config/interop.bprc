# bprc for the ION node (ipn:1). Tokens are substituted by dotest:
#   ION_INDUCT     host:port the quiccla daemon binds (peer target)
#   UNIBO_OUTDUCT  host:port of the Unibo-BP quiccl induct (quiccla connects)
#   CERT / KEY     certificate and key for quiccla
1
a scheme ipn 'ipnfw' 'ipnadminep'
a endpoint ipn:1.0 q
a endpoint ipn:1.2 q
a endpoint ipn:1.4 q
a protocol quic 1400 100
a induct  quic ION_INDUCT 'quiccla -c CERT -k KEY -n'
a outduct quic UNIBO_OUTDUCT ''
r 'ipnadmin config/interop_runtime.ipnrc'
s
