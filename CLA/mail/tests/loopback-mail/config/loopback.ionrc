# ionrc configuration file for mail CLA loopback test.
# command: % ionadmin loopback.ionrc

# Set this node to be node 1 (as in ipn:1).
1 1 ''

# start ion node
s

# Loopback contact (node 1 to itself), 100000 bytes/second.
a contact +1 +3600 1 1 100000

# Loopback range, 1 second one-way light time.
a range +1 +3600 1 1 1

m production 1000000
m consumption 1000000
